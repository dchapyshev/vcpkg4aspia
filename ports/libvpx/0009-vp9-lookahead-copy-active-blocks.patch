diff --git a/vp9/encoder/vp9_extend.c b/vp9/encoder/vp9_extend.c
index 69261ac..e533477 100644
--- a/vp9/encoder/vp9_extend.c
+++ b/vp9/encoder/vp9_extend.c
@@ -13,6 +13,8 @@
 #include "vpx_ports/mem.h"
 
 #include "vp9/common/vp9_common.h"
+#include "vp9/common/vp9_enums.h"
+#include "vp9/encoder/vp9_encoder.h"
 #include "vp9/encoder/vp9_extend.h"
 
 static void copy_and_extend_plane(const uint8_t *src, int src_pitch,
@@ -162,3 +164,87 @@ void vp9_copy_and_extend_frame(const YV12_BUFFER_CONFIG *src,
                         dst->uv_stride, src->uv_crop_width, src->uv_crop_height,
                         et_uv, el_uv, eb_uv, er_uv, chroma_step);
 }
+
+void vp9_copy_and_extend_frame_active(const YV12_BUFFER_CONFIG *src,
+                                      YV12_BUFFER_CONFIG *dst,
+                                      const uint8_t *active_map,
+                                      const uint8_t *prev_active_map,
+                                      int mi_rows, int mi_cols) {
+  // The same extension as in vp9_copy_and_extend_frame().
+  const int et_y = 16;
+  const int el_y = 16;
+  const int er_y =
+      VPXMAX(src->y_width + 16, ALIGN_POWER_OF_TWO(src->y_width, 6)) -
+      src->y_crop_width;
+  const int eb_y =
+      VPXMAX(src->y_height + 16, ALIGN_POWER_OF_TWO(src->y_height, 6)) -
+      src->y_crop_height;
+  const int ss_x = (src->uv_width != src->y_width);
+  const int ss_y = (src->uv_height != src->y_height);
+  int row;
+
+  for (row = 0; row < mi_rows; ++row) {
+    const uint8_t *const map = active_map + row * mi_cols;
+    const uint8_t *const prev_map = prev_active_map + row * mi_cols;
+    const int y = row * MI_SIZE;
+    const int h = VPXMIN(MI_SIZE, src->y_crop_height - y);
+    int col = 0;
+
+    if (h <= 0) break;
+
+    while (col < mi_cols) {
+      int end;
+      int x, w, uv_x, uv_y, uv_w, uv_h, top, bottom, left, right;
+
+      // Find a run of blocks that changed in this frame or in the previous one.
+      while (col < mi_cols && map[col] == AM_SEGMENT_ID_INACTIVE &&
+             prev_map[col] == AM_SEGMENT_ID_INACTIVE) {
+        ++col;
+      }
+      if (col == mi_cols) break;
+
+      end = col;
+      while (end < mi_cols && (map[end] != AM_SEGMENT_ID_INACTIVE ||
+                               prev_map[end] != AM_SEGMENT_ID_INACTIVE)) {
+        ++end;
+      }
+
+      x = col * MI_SIZE;
+      w = VPXMIN(end * MI_SIZE, src->y_crop_width) - x;
+      top = y == 0;
+      bottom = y + h == src->y_crop_height;
+      left = x == 0;
+      right = x + w == src->y_crop_width;
+
+      copy_and_extend_plane(src->y_buffer + y * src->y_stride + x,
+                            src->y_stride,
+                            dst->y_buffer + y * dst->y_stride + x,
+                            dst->y_stride, w, h, top ? et_y : 0,
+                            left ? el_y : 0, bottom ? eb_y : 0,
+                            right ? er_y : 0, 1);
+
+      uv_x = x >> ss_x;
+      uv_y = y >> ss_y;
+      uv_w = (right ? src->uv_crop_width : (x + w) >> ss_x) - uv_x;
+      uv_h = (bottom ? src->uv_crop_height : (y + h) >> ss_y) - uv_y;
+
+      copy_and_extend_plane(src->u_buffer + uv_y * src->uv_stride + uv_x,
+                            src->uv_stride,
+                            dst->u_buffer + uv_y * dst->uv_stride + uv_x,
+                            dst->uv_stride, uv_w, uv_h, top ? et_y >> ss_y : 0,
+                            left ? el_y >> ss_x : 0,
+                            bottom ? eb_y >> ss_y : 0,
+                            right ? er_y >> ss_x : 0, 1);
+
+      copy_and_extend_plane(src->v_buffer + uv_y * src->uv_stride + uv_x,
+                            src->uv_stride,
+                            dst->v_buffer + uv_y * dst->uv_stride + uv_x,
+                            dst->uv_stride, uv_w, uv_h, top ? et_y >> ss_y : 0,
+                            left ? el_y >> ss_x : 0,
+                            bottom ? eb_y >> ss_y : 0,
+                            right ? er_y >> ss_x : 0, 1);
+
+      col = end;
+    }
+  }
+}
